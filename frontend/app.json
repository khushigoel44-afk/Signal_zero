{
  "expo": {
    "name": "OGTPS",
    "slug": "ogtps",
    "sdkVersion": "54.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {},
    "extra": {
      "apiBaseUrl": "http://localhost:5000"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
